# Dependencies (Netlify will install these fresh, don't upload them)
node_modules/
.pnp
.pnp.js

# Production Outputs (Netlify builds its own 'dist' folder on deployment)
dist/
build/

# Local Environment Secrets (Crucial so you don't leak API keys to GitHub)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Debug logs (Prevents junk files from cluttering your repository)
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# System & Editor files
.DS_Store
.vscode/
.idea/